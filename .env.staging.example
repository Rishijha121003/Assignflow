# ==============================================================================
# AssignFlow Staging Environment Configuration Template (.env.staging.example)
#
# Copy this file to .env on your staging server or configure these variables in
# your staging platform's secret manager (e.g. Render, Fly.io, Railway, AWS ECS).
#
# NEVER commit a real .env file containing live staging credentials to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="AssignFlow (Staging)"

# ENVIRONMENT identifies the runtime tier. Set to 'staging' for staging deployments.
ENVIRONMENT=staging

# DEBUG MUST be set to False in staging to mirror production security safeguards.
DEBUG=False

# Canonical public HTTPS URL for the staging application.
CANONICAL_URL=https://staging.assignflow.example.edu

# ------------------------------------------------------------------------------
# 2. Authentication & Secrets
# ------------------------------------------------------------------------------
# SECRET_KEY: Cryptographically secure random 32-byte hex string used to sign JWTs.
# Generate a dedicated staging key using: openssl rand -hex 32
# MUST NOT use the default placeholder key or reuse the production key.
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-for-staging

# JWT Algorithm and expiration time in minutes (1440 = 24 hours)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_NAME=access_token

# Enforce secure cookies (transmitted exclusively over HTTPS)
COOKIE_SECURE=True

# ------------------------------------------------------------------------------
# 3. Database Configuration (Isolated Staging PostgreSQL 14+)
# ------------------------------------------------------------------------------
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>?options=-csearch_path%3Dassignflow,public
#
# CRITICAL REQUIREMENTS:
# 1. Staging MUST connect to an isolated staging database instance or cluster.
#    NEVER point staging to the production database.
# 2. The connecting role must have permission to CREATE SCHEMA IF NOT EXISTS assignflow.
# 3. The connection string must specify '?options=-csearch_path%3Dassignflow,public'.
DATABASE_URL=postgresql+psycopg2://staging_db_user:staging_db_password@staging-db-host.internal:5432/assignflow_staging?options=-csearch_path%3Dassignflow,public

# ------------------------------------------------------------------------------
# 4. CORS Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list of trusted origins permitted to make cross-origin requests.
# Wildcard ('*') is prohibited in staging and production.
# Include the exact staging domain and any staging frontend hosts.
ALLOWED_ORIGINS=https://staging.assignflow.example.edu,https://app.staging.assignflow.example.edu

# ------------------------------------------------------------------------------
# 5. Persistent File Storage
# ------------------------------------------------------------------------------
# Set STORAGE_DIR to the mount path of a persistent block volume or disk.
# Ephemeral container disks will lose assignment PDFs and submissions on redeploy.
STORAGE_DIR=/var/data/assignflow-staging

# Maximum upload file size in megabytes (default 10 MB)
MAX_UPLOAD_SIZE_MB=10

# ------------------------------------------------------------------------------
# 6. Outbound Email / SMTP (Optional for Staging)
# ------------------------------------------------------------------------------
# AssignFlow in-app notifications and student dashboards function fully without SMTP.
# Leave blank to use database-only notifications, or configure a staging mailbox
# (e.g. Mailhog, Mailtrap, or a sandbox SMTP relay) for testing email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
EMAILS_FROM_EMAIL=staging-noreply@assignflow.example.edu
EMAILS_FROM_NAME=AssignFlow Staging Notifications
