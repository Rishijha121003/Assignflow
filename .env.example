# ==============================================================================
# AssignFlow Environment Configuration Template (.env.example)
# Copy this file to .env and configure the values for your deployment.
# NEVER commit your real .env file with production credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Settings
# ------------------------------------------------------------------------------
PROJECT_NAME=AssignFlow
# ENVIRONMENT must be set to 'production' for live deployments, or 'development' locally.
ENVIRONMENT=production
# In production, DEBUG MUST be set to False (application will refuse to start if True).
DEBUG=False
# Optional: Canonical domain URL for the application (e.g. https://assignflow.college.edu)
# Leave blank during local development to avoid forging inaccurate canonical tags.
CANONICAL_URL=https://assignflow.example.edu

# ------------------------------------------------------------------------------
# 2. Authentication & Secrets
# ------------------------------------------------------------------------------
# SECRET_KEY: Secret key used to sign JWT session tokens.
# REQUIRED IN PRODUCTION: You MUST set a unique, cryptographically random secret key.
# Generate one using: openssl rand -hex 32
# If left as default in production, startup validation will intentionally fail.
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-in-production

# JWT Algorithm and expiration time in minutes (1440 = 24 hours)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_NAME=access_token

# ------------------------------------------------------------------------------
# 3. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<dbname>?options=-csearch_path%3Dassignflow,public
# IMPORTANT: The connecting database user MUST have permission to CREATE SCHEMA IF NOT EXISTS assignflow,
# and the connection string must include '?options=-csearch_path%3Dassignflow,public' to isolate tables.
DATABASE_URL=postgresql+psycopg2://db_user:db_password@127.0.0.1:5432/assignflow_prod?options=-csearch_path%3Dassignflow,public

# ------------------------------------------------------------------------------
# 4. CORS Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list of trusted origins permitted to make cross-origin requests.
# REQUIRED IN PRODUCTION: Wildcard ('*') is prohibited and rejected on startup in production.
ALLOWED_ORIGINS=https://assignflow.example.edu,https://app.assignflow.example.edu

# ------------------------------------------------------------------------------
# 5. Persistent File Storage
# ------------------------------------------------------------------------------
# In containerized/cloud deployments (Docker, Kubernetes, Render Disks, Fly Volumes),
# local disk writes are ephemeral. Set STORAGE_DIR to the mount path of your persistent volume.
STORAGE_DIR=/var/data/assignflow

# Alternatively, override individual directories:
# UPLOAD_DIR=/var/data/assignflow/assignments
# SUBMISSIONS_UPLOAD_DIR=/var/data/assignflow/submissions
MAX_UPLOAD_SIZE_MB=10

# ------------------------------------------------------------------------------
# 6. Outbound Email / SMTP (Optional)
# ------------------------------------------------------------------------------
# AssignFlow in-app notifications and student dashboards function fully without SMTP.
# Configure these if you want transactional email alerts for deadlines and grade releases.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True
EMAILS_FROM_EMAIL=noreply@assignflow.edu
EMAILS_FROM_NAME=AssignFlow Notifications
