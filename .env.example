# AssignFlow Environment Configuration

# Application
PROJECT_NAME=AssignFlow
ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<dbname>
# Note: In PostgreSQL, you can isolate AssignFlow to its own schema using the options parameter
DATABASE_URL=postgresql+psycopg2://support_app:rishi12@127.0.0.1:5432/ai_support_platform?options=-csearch_path%3Dassignflow,public

# CORS Allowed Origins (comma-separated or * for development)
ALLOWED_ORIGINS=*
